---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Me"
  description="Feel free to reach out for inquiries or just to say hi!"
  pageClass="contact-page"
>
  <section class="contact-form container mt-5">
    <h4 class="text-center mb-4">Send me a message</h4>
    <form
      id="contact-form"
      action="#"
      method="POST"
      onsubmit="submitForm(event)"
    >
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input
          type="text"
          class="form-control"
          id="name"
          name="name"
          required
        />
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          required
        />
      </div>
      <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <textarea
          class="form-control"
          id="message"
          name="message"
          rows="4"
          required></textarea>
      </div>
      <div class="text-center">
        <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </form>
    <div id="form-message" class="mt-3 text-center"></div>
  </section>
  <!-- Social Icons Section -->
  <div class="social-icons">
    <a
      href="https://github.com/brash83/"
      target="_blank"
      aria-label="Visit my GitHub profile"
    >
      <img
        src="/icons/github.svg"
        alt="Github"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
    <a
      href="https://www.linkedin.com/in/brash83/"
      target="_blank"
      aria-label="Visit my LinkedIn profile"
    >
      <img
        src="/icons/linkedin.svg"
        alt="LinkedIn"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
  </div>
</Layout>
