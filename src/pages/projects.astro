---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Projects"
  description="Check out some of the projects I have worked on."
  gradientColor="linear-gradient(45deg, #64ea55, #377bf6)"
  pageClass="projects-page"
>
  <!-- Projects List Section -->
  <section class="projects-list">
    <!-- Content will be dynamically filled by JavaScript -->
  </section>

  <br /><br />
  <br />
  <br />
  <br />
  <br />
  <br />

  <!-- Project 1 Details -->
  <section class="project-details" id="project1">
    <div class="project-detail-left">
      <h1 class="project-title">
        Recce Library App <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        Recces would be carried out and the information wouldn't be saved
        anywhere leading to sites being rechecked multiple times.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Apps)
      </h2>
      <ul>
        <li>
          <strong>App Creation:</strong> Mobile and desktop application to input
          quality and uniform recce information.
        </li>
        <li>
          <strong>Design:</strong> Designed with ease of use in mind. Bi-Lingual
          to accommodate Irish speakers.
        </li>
        <li>
          <strong>Database:</strong> All information and media housed in an in-app
          gallery and backed up in SharePoint.
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img
          src="/images/project1-1.jpg"
          alt="Thumbnail 1"
          class="project-thumbnail"
          data-full="/images/project1-1.jpg"
        />
        <img
          src="/images/project1-2.jpg"
          alt="Thumbnail 2"
          class="project-thumbnail"
          data-full="/images/project1-2.jpg"
        />
        <img
          src="/images/project1-3.jpg"
          alt="Thumbnail 3"
          class="project-thumbnail"
          data-full="/images/project1-3.jpg"
        />
      </div>
    </div>
  </section>

  <!-- Project 2 Details -->
  <section class="project-details" id="project2">
    <div class="project-detail-left">
      <h1 class="project-title">
        Overtime Dashboard <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        Inability to report on: overtime reasons, yearly trends, employee-level
        review.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power BI)
      </h2>
      <ul>
        <li>
          <strong>Tracker Creation:</strong> Simple Excel-based overtime tracker.
        </li>
        <li>
          <strong>Connection:</strong> Integrated data into Power BI for accuracy.
        </li>
        <li>
          <strong>Design:</strong> Dashboard with filters by genre, person, date
          range.
        </li>
        <li>
          <strong>Expansion:</strong> Extended to multiple departments in 2022.
        </li>
        <li>
          <strong>Line Management:</strong> Employee-level reporting for managers.
        </li>
        <li><strong>KPI and Metrics:</strong> Automated statistics added.</li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img
          src="/images/project1-1.jpg"
          alt="Thumbnail 1"
          class="project-thumbnail"
          data-full="/images/project1-1.jpg"
        />
        <img
          src="/images/project1-2.jpg"
          alt="Thumbnail 2"
          class="project-thumbnail"
          data-full="/images/project1-2.jpg"
        />
        <img
          src="/images/project1-3.jpg"
          alt="Thumbnail 3"
          class="project-thumbnail"
          data-full="/images/project1-3.jpg"
        />
      </div>
    </div>
  </section>

  <!-- Project 3 Details -->
  <section class="project-details" id="project3">
    <div class="project-detail-left">
      <h1 class="project-title">
        Vehicle Reservations App <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        No system in place to manage our vehicle fleet, report issues, and avoid
        unnecessary commercial hires.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Apps)
      </h2>
      <ul>
        <li>
          <strong>App Creation:</strong> Mobile & desktop system for reserving vehicles.
        </li>
        <li>
          <strong>'Return Centre':</strong> Includes time-stamped photo & video check-in.
        </li>
        <li>
          <strong>Archive:</strong> All bookings & media stored in SharePoint.
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img
          src="/images/veh1.jpg"
          alt="Thumbnail 1"
          class="project-thumbnail"
          data-full="/images/veh1.jpg"
        />
        <img
          src="/images/veh2.jpg"
          alt="Thumbnail 2"
          class="project-thumbnail"
          data-full="/images/veh2.jpg"
        />
        <img
          src="/images/veh3.jpg"
          alt="Thumbnail 3"
          class="project-thumbnail"
          data-full="/images/veh3.jpg"
        />
      </div>
    </div>
  </section>

  <br /><br />

  <!-- Project 4 Details -->
  <section class="project-details" id="project4">
    <div class="project-detail-left">
      <h1 class="project-title">
        Operations Bot <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        The operations team identified 12 areas in which to comply with the
        company's GDPR practices. This issue was a lack of a system to remind
        when to action these.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Automate)
      </h2>
      <ul>
        <li>
          <strong>Creation:</strong> After all ROPAs were signed off and sent to
          the GDPR team, I created an Excel sheet to assign actions to employees
          and map out specified reminder dates for up to ten years. Using Power Automate,
          timed reminders fire via a 'bot' to the assignee outlining the exact task
          required with a link to the source documents and GDPR policies. This is
          known as 'Ops Bot' <br />
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img
          src="/images/project1-1.jpg"
          alt="Thumbnail 1"
          class="project-thumbnail"
          data-full="/images/project1-1.jpg"
        />
        <img
          src="/images/project1-2.jpg"
          alt="Thumbnail 2"
          class="project-thumbnail"
          data-full="/images/project1-2.jpg"
        />
        <img
          src="/images/project1-3.jpg"
          alt="Thumbnail 3"
          class="project-thumbnail"
          data-full="/images/project1-3.jpg"
        />
      </div>
    </div>
  </section>

  <!-- Lightbox Popup (for images) -->
  <div id="popupOverlay" class="popup-overlay">
    <div class="popup">
      <span class="close-btn">&times;</span>
      <img id="popupImage" class="popup-image" />
    </div>
  </div>

  <!-- Client-side Script for Sorting, Rendering Projects, and Lightbox -->
  <script client:load>
    window.onload = function () {
      const projects = [
        { title: "Overtime Dashboard", id: "project2" },
        { title: "Vehicle Reservations", id: "project3" },
        { title: "Recce Library", id: "project1" },
        { title: "Operations Bot", id: "project4" },
      ];

      // Generate HTML for the projects list
      const projectList = document.querySelector(".projects-list");
      projectList.innerHTML = projects
        .map(
          (project) => `
        <div class="project">
          <a href="#${project.id}" class="project-link">${project.title}</a>
        </div>
      `
        )
        .join("");

      // Add smooth scrolling functionality to project links
      const projectLinks = document.querySelectorAll(".project-link");
      projectLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const targetId = e.target.getAttribute("href").substring(1); // Get the target ID without '#'
          const targetSection = document.getElementById(targetId);

          targetSection.scrollIntoView({
            behavior: "smooth", // Smooth scroll
            block: "start", // Align the section to the top
          });
        });
      });

      // Lightbox functionality
      const images = document.querySelectorAll(".project-thumbnail");

      images.forEach((image) => {
        image.addEventListener("click", function () {
          const popupOverlay = document.getElementById("popupOverlay");
          const popupImage = document.getElementById("popupImage");

          // Set the clicked image to be the popup image
          popupImage.src = this.dataset.full;

          // Show the lightbox
          popupOverlay.style.display = "flex";
        });
      });

      // Close lightbox functionality
      const closeBtn = document.querySelector(".close-btn");
      const popupOverlay = document.getElementById("popupOverlay");
      closeBtn.addEventListener("click", function () {
        popupOverlay.style.display = "none";
      });

      // Close lightbox when clicking outside the image
      popupOverlay.addEventListener("click", function (e) {
        if (e.target === popupOverlay) {
          popupOverlay.style.display = "none";
        }
      });
    };
  </script>

  <style>
    /* Adding circle styles */
    .circle {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 10px;
    }

    .circle.red {
      background-color: #c30808; /* Red circle */
    }

    .circle.green {
      background-color: #04a404; /* Green circle */
    }

    /* Adding styling for h1 */
    .project-title {
      color: #008080; /* Teal color */
      font-size: 2rem; /* Larger font size for titles */
      font-weight: bold; /* Bold font */
      text-transform: uppercase; /* Uppercase titles */
      line-height: 1.2; /* Line height for better spacing */
    }

    /* Add other relevant styles */
    .projects-list {
      list-style: none;
      padding: 0;
    }

    .project {
      margin: 10px 0;
    }

    .project-link {
      text-decoration: none;
      font-weight: bold;
      color: #377bf6; /* Blue color for the project links */
    }

    .project-link:hover {
      color: #64ea55; /* Green color on hover */
    }

    /* Styling for problem/solution heading */
    .problem-heading,
    .solution-heading {
      font-size: 1.5rem;
      font-weight: bold;
      margin-bottom: 10px;
    }
  </style>
</Layout>
