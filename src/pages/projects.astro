<!-- Client-side Script for Sorting and Rendering Projects -->
<script client:load>
  window.onload = function () {
    const projects = [
      { title: "Vehicle Booking App", id: "project3" },
      { title: "Recce Library", id: "project1" },
      { title: "OPs Bot", id: "project4" },
      { title: "Overtime Dashboard", id: "project2" },
    ];

    // Sort the projects alphabetically by title
    projects.sort((a, b) =>
      a.title.localeCompare(b.title, undefined, { sensitivity: "base" })
    );

    // Generate HTML for the projects list
    const projectList = document.querySelector(".projects-list");
    projectList.innerHTML = projects
      .map(
        (project) => `
        <div class="project">
          <a href="#${project.id}" class="project-link">${project.title}</a>
        </div>
      `
      )
      .join("");
  };
</script>
