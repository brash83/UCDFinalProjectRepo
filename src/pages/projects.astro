---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Projects"
  description="Check out some of the projects I have worked on."
  gradientColor="linear-gradient(45deg, #64ea55, #377bf6)"
  pageClass="projects-page"
>
  <!-- Projects List Section -->
  <section class="projects-list">
    <!-- Content will be dynamically filled by JavaScript -->
  </section>

  <br /><br />
  <br />
  <br />
  <br />
  <br />
  <br />

  <!-- Project 1 Details -->
  <section class="project-details" id="project1">
    <div class="project-detail-left">
      <h1 class="project-title">
        Recce Library App <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        Recces would be carried out and the information wouldn't be saved
        anywhere leading to sites being rechecked multiple times.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Apps)
      </h2>
      <ul>
        <li>
          <strong>App Creation:</strong> Mobile and desktop application to input
          quality and uniform recce information.
        </li>
        <li>
          <strong>Design:</strong> Designed with ease of use in mind. Bi-Lingual
          to accomodate Irish speakers.
        </li>
        <li>
          <strong>Database:</strong> All information and media house in an in-app
          gallery and backed up in SharePoint.
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
        <!-- Upward arrow -->
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img src="/images/project1-1.jpg" alt="Project 1 Image 1" />
        <img src="/images/project1-2.jpg" alt="Project 1 Image 2" />
      </div>
    </div>
  </section>

  <br /><br />

  <!-- Project 2 Details -->
  <section class="project-details" id="project2">
    <div class="project-detail-left">
      <h1 class="project-title">
        Overtime Dashboard <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        Inability to report on: overtime reasons, yearly trends, employee-level
        review.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power BI)
      </h2>
      <ul>
        <li>
          <strong>Tracker Creation:</strong> Simple Excel-based overtime tracker.
        </li>
        <li>
          <strong>Connection:</strong> Integrated data into Power BI for accuracy.
        </li>
        <li>
          <strong>Design:</strong> Dashboard with filters by genre, person, date
          range.
        </li>
        <li>
          <strong>Expansion:</strong> Extended to multiple departments in 2022.
        </li>
        <li>
          <strong>Line Management:</strong> Employee-level reporting for managers.
        </li>
        <li><strong>KPI and Metrics:</strong> Automated statistics added.</li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
        <!-- Upward arrow -->
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img src="/images/project2-1.jpg" alt="Project 2 Image 1" />
        <img src="/images/project2-2.jpg" alt="Project 2 Image 2" />
      </div>
    </div>
  </section>

  <br /><br />

  <!-- Project 3 Details -->
  <section class="project-details" id="project3">
    <div class="project-detail-left">
      <h1 class="project-title">
        Vehicle Reservations App <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        No system in place to manage our vehicle fleet, report issues, and avoid
        unnecessary commercial hires.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Apps)
      </h2>
      <ul>
        <li>
          <strong>App Creation:</strong> Mobile & desktop system for reserving vehicles.
        </li>
        <li>
          <strong>'Return Centre':</strong> Includes time-stamped photo & video check-in.
        </li>
        <li>
          <strong>Archive:</strong> All bookings & media stored in SharePoint.
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
        <!-- Upward arrow -->
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img src="/images/project3-1.jpg" alt="Project 3 Image 1" />
      </div>
    </div>
  </section>

  <br /><br />

  <!-- Project 4 Details -->
  <section class="project-details" id="project4">
    <div class="project-detail-left">
      <h1 class="project-title">
        OPs Bot <br />
      </h1>
      <br />
      <h2 class="problem-heading">
        <span class="circle red"></span> Problems
      </h2>
      <p>
        The operations team identified 12 areas in which to comply with the
        company's GDPR practices. This issue was a lack of a system to remind
        when to action these.
      </p>

      <h2 class="solution-heading">
        <span class="circle green"></span> Solution (created with Power Automate)
      </h2>
      <ul>
        <li>
          <strong>Creation:</strong> After all ROPAs were signed off and sent to
          the GDPR team, I created an Excel sheet to assign actions to employees
          and map out specified reminder dates for up to ten years. Using Power Automate,
          timed reminders fire via a 'bot' to the assignee outlining the exact task
          required with a link to the source documents and GDPR policies.
        </li>
      </ul>

      <!-- Scroll-to-top button -->
      <a href="#top" class="scroll-to-top">
        <span class="arrow-up">&#8593;</span>
        <!-- Upward arrow -->
      </a>
    </div>
    <div class="project-detail-right">
      <div class="carousel">
        <img src="/images/project4-1.jpg" alt="Project 4 Image 1" />
      </div>
    </div>
  </section>

  <!-- Client-side Script for Sorting and Rendering Projects -->
  <script client:load>
    window.onload = function () {
      const projects = [
        { title: "Vehicle Booking App", id: "project3" },
        { title: "Recce Library", id: "project1" },
        { title: "OPs Bot", id: "project4" },
        { title: "Overtime Dashboard", id: "project2" },
      ];

      // Sort the projects alphabetically by title
      projects.sort((a, b) =>
        a.title.localeCompare(b.title, undefined, { sensitivity: "base" })
      );

      // Generate HTML for the projects list
      const projectList = document.querySelector(".projects-list");
      projectList.innerHTML = projects
        .map(
          (project) => `
        <div class="project">
          <a href="#${project.id}" class="project-link">${project.title}</a>
        </div>
      `
        )
        .join("");
    };
  </script>

  <style>
    .project-title {
      color: rgb(11, 103, 134);
    }

    .project-details {
      display: flex;
      align-items: flex-start;
      gap: 20px; /* Spacing between text & images */
      margin-bottom: 350px; /* Space between projects */
    }

    .project-detail-left {
      flex: 1;
      text-align: left;
    }

    .project-details ul {
      list-style-type: disc;
      padding-left: 20px;
    }

    .carousel img {
      max-width: 100%;
      border-radius: 10px;
    }

    .problem-heading,
    .solution-heading {
      display: flex;
      align-items: center;
      font-size: 1.5rem;
      color: black;
    }

    .circle {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      margin-right: 10px;
    }

    .red {
      background-color: red;
    }

    .green {
      background-color: green;
    }

    .scroll-to-top {
      display: inline-block;
      margin-top: 20px;
      font-size: 2rem;
      color: rgb(11, 103, 134);
      text-decoration: none;
      display: block;
    }

    .arrow-up {
      font-size: 2.5rem;
      color: rgb(11, 103, 134);
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .scroll-to-top:hover .arrow-up {
      transform: translateY(-5px);
    }
  </style>
</Layout>
