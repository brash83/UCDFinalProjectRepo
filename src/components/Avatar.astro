<!-- Avatar Component (Initially hidden) -->
<div
  id="avatar"
  class="pointer-events-none absolute opacity-0 transition-all lg:block"
  style="width: 150px; height: 150px; z-index: 10; position: absolute; top: -9999px; left: -9999px;"
  <!--
  Initially
  off-screen
  --
>
  >
  <img
    src="/images/profile-pic.png"
    alt="Brian Cash"
    class="w-full h-full rounded-full object-cover"
  />
</div>

<!-- Hover Trigger (Brian Cash text) -->
<h2>
  Hi <span id="wave">👋</span>, I'm <a
    id="avatar-trigger"
    href="https://github.com/brash83/"
    target="_blank"
    title="View Github Profile"
    class="text-orange-500 underline"
    >Brian Cash
  </a>
</h2>

<script client:load>
  const avatar = document.getElementById("avatar");
  const trigger = document.getElementById("avatar-trigger");

  // Show the avatar when mouse enters "Brian Cash"
  trigger?.addEventListener("mouseenter", () => {
    if (avatar) {
      avatar.style.opacity = "1"; // Show the avatar
    }
  });

  // Hide the avatar when mouse leaves "Brian Cash"
  trigger?.addEventListener("mouseleave", () => {
    if (avatar) {
      avatar.style.opacity = "0"; // Hide the avatar
    }
  });

  // Follow the mouse movement with the avatar when hovering over "Brian Cash"
  window.addEventListener("mousemove", (e) => {
    if (avatar && trigger) {
      const triggerRect = trigger.getBoundingClientRect();

      // Check if the mouse is inside the "Brian Cash" element
      const isMouseInsideTrigger =
        e.clientX >= triggerRect.left &&
        e.clientX <= triggerRect.right &&
        e.clientY >= triggerRect.top &&
        e.clientY <= triggerRect.bottom;

      // Only move the avatar if the mouse is inside the "Brian Cash" area
      if (isMouseInsideTrigger) {
        const x = e.clientX;
        const y = e.clientY;

        // Offset the avatar near the mouse
        const offsetX = 20; // Adjust to control how far the avatar is from the mouse
        const offsetY = 20; // Adjust to control how far the avatar is from the mouse

        // Set the avatar's position beside the mouse
        avatar.style.left = `${x + offsetX}px`;
        avatar.style.top = `${y + offsetY}px`;
      }
    }
  });
</script>
