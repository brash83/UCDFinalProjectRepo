---
// Layout.astro
import NavBar from "../components/navbar.astro";

interface Props {
  title: string;
  description: string;
  gradientColor?: string;
  pageClass?: string; // New prop to pass page-specific class
}

const { title, description, gradientColor, pageClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class={pageClass || ""}>
    <!-- Apply the page-specific class here -->
    <header>
      <NavBar />
    </header>

    <!-- Hero Section -->
    <section
      class="hero"
      style={gradientColor
        ? `background: ${gradientColor};`
        : "background: linear-gradient(45deg, #FF6347, #4B0082);"}
    >
      <div class="hero-content">
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
    </section>

    <!-- Main content injected here -->
    <main>
      <slot />
    </main>

    <!-- Footer Section -->
    <footer>
      <p>&copy; 2024 Brian Cash. All rights reserved.</p>
    </footer>
  </body>
</html>
