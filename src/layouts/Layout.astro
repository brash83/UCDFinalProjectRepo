---
// Layout.astro
import NavBar from '../components/navbar.astro';

interface Props {
  title: string;
  description: string;
  gradientColor?: string;
}

const { title, description, gradientColor } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <NavBar />
    </header>

    <!-- Gradient Section for all pages -->
    <section class="gradient-section" style={gradientColor ? `background: ${gradientColor};` : 'background: linear-gradient(45deg, #FF6347, #4B0082);'}>
      <div class="gradient-content">
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
    </section>

    <!-- Main content injected here -->
    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2024 Brian Cash. All rights reserved.</p>
    </footer>
  </body>
</html>
