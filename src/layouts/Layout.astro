---
import NavBar from "../components/navbar.astro";

interface Props {
  title?: string;
  description?: string;
  gradientColor?: string;
  pageClass?: string;
}

const { title, description, gradientColor, pageClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description || "Welcome to my portfolio"}
    />
    <title>{title || "My Portfolio"}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class={pageClass || ""}>
    <!-- Hero Section with Navbar inside -->
    <section
      class="hero"
      style={gradientColor
        ? `background: ${gradientColor};`
        : "background: linear-gradient(45deg, #EAf165, #103B72);"}
    >
      <NavBar />
      <div class="hero-content">
        <h1>{title || "Welcome!"}</h1>
        <p>{description || "Explore my world of creativity and code."}</p>
      </div>
    </section>

    <main>
      <div class="content-container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="content-container">
        <p>&copy; 2024 Brian Cash. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const modeToggle = document.getElementById("mode-toggle");

      modeToggle.addEventListener("click", () => {
        const isDarkMode = document.body.classList.toggle("dark-mode");
        modeToggle.textContent = isDarkMode ? "🌞" : "🌙";
      });
    </script>
  </body>
</html>
