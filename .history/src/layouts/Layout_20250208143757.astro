---
import NavBar from "../components/navbar.astro";

interface Props {
  title?: string;
  description?: string;
  gradientColor?: string;
  pageClass?: string;
}

const { title, description, gradientColor, pageClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description || "Welcome to my portfolio"}
    />
    <title>{title || "My Portfolio"}</title>
    <link rel="stylesheet" href="/UCDFinalProjectRepo/styles.css" />

    <style>
      /* Ensure the wrapper takes up full height and prevents layout shift */
      .page-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1; /* Allows the main content to take up available space */
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .content-container {
        max-width: 1200px;
        width: 100%;
        padding: 20px;
      }

      footer {
        text-align: center;
        padding: 10px;
        background: #222;
        color: white;
      }

      /* Mobile Responsive Adjustments */
      @media (max-width: 768px) {
        .hero-content {
          text-align: center;
          padding: 20px;
        }
      }
    </style>
  </head>
  <body class={pageClass || ""}>
    <div class="page-wrapper">
      <!-- Hero Section with Navbar inside -->
      <section
        class="hero"
        style={gradientColor
          ? `background: ${gradientColor};`
          : "background: linear-gradient(45deg, #EAf165, #103B72);"}
      >
        <NavBar />
        <div class="hero-content">
          <h1>{title || "Welcome!"}</h1>
          <p>{description || "Explore my world of creativity and code."}</p>
        </div>
      </section>

      <main>
        <div class="content-container">
          <slot />
        </div>
      </main>

      <footer>
        <div class="content-container">
          <p>&copy; 2025 Brian Cash. All rights reserved.</p>
        </div>
      </footer>
    </div>

    <script>
      // Ensure that modeToggle is not null before adding the event listener
      const modeToggle = document.getElementById("mode-toggle");

      if (modeToggle) {
        // Check localStorage or a default for the initial dark mode state
        let isDarkMode = localStorage.getItem("dark-mode") === "true"; // Check if dark mode is enabled from previous session

        // Initially set the icon based on the current theme
        modeToggle.textContent = isDarkMode ? "🌙" : "🌞"; // Assuming 🌙 for dark mode and 🌞 for light mode

        modeToggle.addEventListener("click", () => {
          isDarkMode = !isDarkMode; // Toggle the mode
          modeToggle.textContent = isDarkMode ? "🌙" : "🌞"; // Toggle the icon

          // Update the theme (e.g., add/remove class or store in localStorage)
          document.body.classList.toggle("dark-mode", isDarkMode);
          localStorage.setItem("dark-mode", isDarkMode.toString()); // Save the preference
        });
      }
    </script>
  </body>
</html>
