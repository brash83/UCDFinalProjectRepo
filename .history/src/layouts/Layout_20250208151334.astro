---
import NavBar from "../components/navbar.astro";

interface Props {
  title?: string;
  description?: string;
  gradientColor?: string;
  pageClass?: string;
}

const { title, description, gradientColor, pageClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description || "Welcome to my portfolio"}
    />
    <title>{title || "My Portfolio"}</title>
    <link rel="stylesheet" href="/UCDFinalProjectRepo/styles.css" />

    <style>
      /* Ensure the wrapper takes up full height and prevents layout shift */
      .page-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      /* Hero section with full height */
      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh; /* Ensures it takes full viewport height */
        text-align: center;
        color: white;
      }

      /* Adjusted hero content spacing */
      .hero-content {
        margin-top: 60px; /* Adjust spacing below navbar */
        max-width: 800px;
        width: 100%;
      }

      .hero-content h1 {
        font-size: 3rem;
        margin-bottom: 20px;
      }

      .hero-content p {
        font-size: 1.3rem;
        line-height: 1.5;
        margin-top: 10px;
      }

      main {
        flex: 1; /* Allows the main content to take up available space */
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .content-container {
        max-width: 1200px;
        width: 100%;
        padding: 20px;
      }

      footer {
        text-align: center;
        padding: 10px;
        background: #222;
        color: white;
      }

      /* Mobile Responsive Adjustments */
      @media (max-width: 768px) {
        .hero-content {
          margin-top: 100px; /* Push down further for smaller screens */
          padding: 20px;
        }

        .hero-content h1 {
          font-size: 2.5rem;
        }

        .hero-content p {
          font-size: 1.2rem;
        }
      }
    </style>
  </head>
  <body class={pageClass || ""}>
    <div class="page-wrapper">
      <!-- Hero Section with Navbar inside -->
      <section
        class="hero"
        style={gradientColor
          ? `background: ${gradientColor};`
          : "background: linear-gradient(45deg, #EAf165, #103B72);"}
      >
        <NavBar />

        <!-- Adjusted hero content spacing -->
        <div class="hero-content">
          <h1>{title || "Welcome!"}</h1>
          <p>{description || "Explore my world of creativity and code."}</p>
        </div>
      </section>

      <main>
        <div class="content-container">
          <slot />
        </div>
      </main>

      <footer>
        <div class="content-container">
          <p>&copy; 2025 Brian Cash. All rights reserved.</p>
        </div>
      </footer>
    </div>

    <script>
      const modeToggle = document.getElementById("mode-toggle");

      if (modeToggle) {
        let isDarkMode = localStorage.getItem("dark-mode") === "true";

        modeToggle.textContent = isDarkMode ? "🌙" : "🌞";

        modeToggle.addEventListener("click", () => {
          isDarkMode = !isDarkMode;
          modeToggle.textContent = isDarkMode ? "🌙" : "🌞";
          document.body.classList.toggle("dark-mode", isDarkMode);
          localStorage.setItem("dark-mode", isDarkMode.toString());
        });
      }
    </script>
  </body>
</html>
