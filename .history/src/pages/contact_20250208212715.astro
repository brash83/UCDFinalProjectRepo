---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Me"
  description="Feel free to reach out for inquiries or just to say hi!"
  gradientColor="linear-gradient(45deg, #FCD38C, #420875)"
  pageClass="contact-page"
>
  <section class="contact-form container mt-5">
    <h4 class="text-center mb-4">Send me a message</h4>
    <form
      id="contact-form"
      action="https://formspree.io/f/xwpvqvnd"
      method="POST"
    >
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input
          type="text"
          class="form-control"
          id="name"
          name="name"
          required
        />
        <small id="name-error" class="text-danger"></small>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          required
        />
        <small id="email-error" class="text-danger"></small>
      </div>

      <div class="mb-3">
        <label for="message" class="form-label">Message</label>
        <textarea
          class="form-control"
          id="message"
          name="message"
          rows="4"
          required></textarea>
        <small id="message-error" class="text-danger"></small>
      </div>

      <div class="text-center">
        <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </form>

    <div id="form-message" class="mt-3 text-center"></div>
  </section>

  <!-- Social Icons Section -->
  <div class="social-icons">
    <a
      href="https://github.com/brash83/"
      target="_blank"
      aria-label="Visit my GitHub profile"
    >
      <img
        src="/UCDFinalProjectRepo/icons/github.svg"
        alt="Github"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
    <a
      href="https://www.linkedin.com/in/brash83/"
      target="_blank"
      aria-label="Visit my LinkedIn profile"
    >
      <img
        src="/UCDFinalProjectRepo/icons/linkedin.svg"
        alt="LinkedIn"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
  </div>

  <!-- JavaScript -->
  <script>
    document
      .getElementById("contact-form")
      ?.addEventListener("submit", function (event) {
        event.preventDefault(); // Prevent default form submission

        let isValid = true;
        const name =
          (document.getElementById("name") as HTMLInputElement)?.value.trim() ||
          "";
        const email =
          (
            document.getElementById("email") as HTMLInputElement
          )?.value.trim() || "";
        const message =
          (
            document.getElementById("message") as HTMLTextAreaElement
          )?.value.trim() || "";

        const nameError = document.getElementById("name-error");
        const emailError = document.getElementById("email-error");
        const messageError = document.getElementById("message-error");
        const formMessage = document.getElementById("form-message");

        // Reset previous error messages
        if (nameError) nameError.innerText = "";
        if (emailError) emailError.innerText = "";
        if (messageError) messageError.innerText = "";
        if (formMessage) formMessage.innerHTML = "";

        // Name validation
        if (name === "") {
          if (nameError) nameError.innerText = "Please enter your name.";
          isValid = false;
        }

        // Email validation (must contain @ and .)
        if (!email.includes("@") || !email.includes(".")) {
          if (emailError)
            emailError.innerText = "Please enter a valid email address.";
          isValid = false;
        }

        // Message validation
        if (message === "") {
          if (messageError) messageError.innerText = "Please enter a message.";
          isValid = false;
        }

        if (!isValid) return;

        const formData = new FormData(event.target as HTMLFormElement);
        fetch((event.target as HTMLFormElement).action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        })
          .then((response) => {
            if (response.ok) {
              if (formMessage) {
                formMessage.innerHTML =
                  "<span style='color: green;'>Message sent successfully!</span>";
              }
              (event.target as HTMLFormElement).reset();
            } else {
              if (formMessage) {
                formMessage.innerHTML =
                  "<span style='color: red;'>Oops! Something went wrong.</span>";
              }
            }
          })
          .catch(() => {
            if (formMessage) {
              formMessage.innerHTML =
                "<span style='color: red;'>An error occurred. Please try again.</span>";
            }
          });
      });
  </script>
</Layout>
