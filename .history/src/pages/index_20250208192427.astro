---
import Layout from "../layouts/Layout.astro";
---

<Layout pageClass="home-page">
  <!-- Main content injected into Layout here -->
  <div class="hero-content">
    <br />
    <h2>
      Hi <span id="wave">👋</span>, I'm <a
        id="avatar-trigger"
        href="https://github.com/brash83/"
        target="_blank"
        title="View Github Profile"
        class="text-orange-500 underline"
      >
        Brian
      </a>
    </h2>
    <br />
    <p>
      Welcome to my portfolio!
      <br />
      I've created solutions using a variety of programs, and I'm now learning about
      front-end development by building this site. Have a look around.
    </p>
    <br />
    <br />
    <a href="/about" class="cta-button">Learn More About Me</a>
  </div>

  <!-- Social Icons Section -->
  <div class="social-icons">
    <a
      href="https://github.com/brash83/"
      target="_blank"
      aria-label="Visit my GitHub profile"
    >
      <img
        src="/UCDFinalProjectRepo/icons/github.svg"
        alt="Github"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
    <a
      href="https://www.linkedin.com/in/brash83/"
      target="_blank"
      aria-label="Visit my LinkedIn profile"
    >
      <img
        src="/UCDFinalProjectRepo/icons/linkedin.svg"
        alt="LinkedIn"
        class="w-8 h-8 text-gray-500 hover:text-gray-700"
        loading="lazy"
      />
    </a>
  </div>

  <!-- Add the JavaScript for the fade effect -->
  <script type="module" is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const heroSection = document.querySelector(".hero");

      // Handle scroll event
      window.addEventListener("scroll", function () {
        if (window.scrollY > 100) {
          // Adjust scroll threshold as needed
          heroSection.classList.add("fade-out");
        } else {
          heroSection.classList.remove("fade-out");
        }
      });
    });
  </script>
</Layout>
