---
const { title, description } = Astro.props;
---

<nav class="navbar">
  <div class="container">
    <!-- Left Side: Name & Profile -->
    <div class="hero-left">
      <a class="navbar-brand" href="/">Brian Cash</a>
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Right Side: Navigation Links -->
    <div class="nav-right">
      <ul class="navbar-links" id="navbar-links">
        <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
        <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
        <li>
          <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
        </li>
        <li class="nav-item">
          <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download
            >My CV</a
          >
        </li>
      </ul>
      <button id="mode-toggle" class="mode-toggle">🌙</button>
    </div>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  /* GLOBAL STYLES */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: "Fixedsys", monospace;
    line-height: 1.6;
    background-color: #f5f5f5;
    color: #333;
  }

  /* NAVBAR */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    position: relative;
    z-index: 1000;
    color: white;
    background-color: transparent;
    height: 80px;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Left Side: Profile and Name */
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: absolute;
    left: 5%;
    top: 40%; /* Adjusted for more downward space */
    transform: translateY(-50%);
  }

  .navbar-brand {
    font-size: 1.8rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    margin-bottom: 10px; /* Adjust for spacing */
  }

  .profile-photo {
    margin-top: 20px; /* Adjusted to move it down more */
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 2px solid white;
    overflow: hidden;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
  }

  .profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Right Side: Navbar Links */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    position: absolute;
    right: 5%;
  }

  .navbar-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 1rem;
    font-weight: 500;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    transition: background-color 0.3s;
  }

  .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .mode-toggle {
    background: transparent;
    border: none;
    color: white;
    font-size: 1.2rem;
    cursor: pointer;
  }

  /* Hero Section */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 15vh;
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-text h1 {
    font-size: 2.5rem;
  }

  .hero-text p {
    font-size: 1.2rem;
  }

  /* HAMBURGER MENU */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
  }

  .hamburger-menu span {
    width: 30px;
    height: 3px;
    background: white;
    transition: 0.3s;
  }

  /* Mobile Navbar */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
      position: absolute;
      right: 20px; /* Hamburger positioned on the right */
    }

    .navbar-links {
      position: absolute;
      top: 50px;
      right: 0;
      width: 100%;
      flex-direction: column;
      align-items: center;
      display: none;
      background: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
    }

    .navbar-links.show {
      display: flex;
    }

    .nav-link {
      color: white;
      padding: 1rem; /* Added padding for better click area */
    }
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector("#navbar-links");

  if (menuToggle && navbarLinks) {
    menuToggle.addEventListener("click", () => {
      navbarLinks.classList.toggle("show");
    });
  }
</script>
