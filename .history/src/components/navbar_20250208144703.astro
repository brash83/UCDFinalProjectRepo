---
const isMobileMenuOpen = false;
---

<nav class="navbar">
  <div class="container">
    <div class="navbar-brand-container">
      <a class="navbar-brand" href="/">Brian Cash</a>
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Hamburger Menu Button -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Navigation Links -->
    <ul class="navbar-links">
      <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
      <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
      <li>
        <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
      </li>
      <li>
        <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
      </li>
      <li class="nav-item">
        <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download>My CV</a
        >
      </li>
    </ul>

    <button id="mode-toggle" class="mode-toggle">🌙</button>
  </div>
</nav>

<style>
  /* Base Navbar Styles */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: linear-gradient(45deg, #eaf165, #103b72); /* Full Gradient */
    color: white;
    position: relative;
  }

  .container {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
  }

  .navbar-brand {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
  }

  /* Fix: Profile photo restored to original size */
  .profile-photo img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin-left: 15px;
  }

  /* Navigation Links */
  .navbar-links {
    display: flex;
    list-style: none;
    gap: 20px;
  }

  .nav-link {
    text-decoration: none;
    color: white;
    font-size: 1rem;
  }

  .mode-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Mobile Menu - Hidden by default */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
  }

  .hamburger-menu span {
    width: 30px;
    height: 3px;
    background: white;
    transition: 0.3s;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
    }

    /* Fix: Full-width dropdown background */
    .navbar-links {
      position: absolute;
      top: 60px;
      left: 0;
      width: 100%;
      background: linear-gradient(
        45deg,
        #eaf165,
        #103b72
      ); /* Ensure full gradient */
      flex-direction: column;
      align-items: center;
      display: none;
      padding: 15px 0;
    }

    .navbar-links.show {
      display: flex;
    }

    .nav-link {
      padding: 10px;
      font-size: 1.2rem;
    }
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector(".navbar-links");

  menuToggle.addEventListener("click", () => {
    navbarLinks.classList.toggle("show");
  });
</script>
