---
const { title, description } = Astro.props;
---

<nav class="navbar">
  <div class="container">
    <!-- Left Side: Name & Profile -->
    <div class="hero-left">
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Right Side: Navigation Links -->
    <div class="nav-right">
      <ul class="navbar-links" id="navbar-links">
        <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
        <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
        <li>
          <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
        </li>
        <li class="nav-item">
          <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download
            >My CV</a
          >
        </li>
      </ul>
      <button id="mode-toggle" class="mode-toggle">🌙</button>
    </div>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  /* NAVBAR */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background: transparent;
    color: white;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Left Side: Profile */
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: absolute;
    left: 5%;
    top: 50%; /* Adjusted to make Brian Cash visible and profile photo comes down */
    transform: translateY(-50%);
  }

  .profile-photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 4px;
    margin-top: 10px; /* Added margin to move profile photo down */
  }

  .profile-photo img {
    width: 175px;
    height: 175px;
    border-radius: 50%;
  }

  /* Right Side: Nav Links */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    position: absolute;
    right: 5%;
    top: 15px; /* Adjusted top position */
  }

  .navbar-links {
    display: flex;
    list-style: none;
    gap: 20px;
  }

  .nav-link {
    text-decoration: none;
    color: white;
    font-size: 1rem;
  }

  .mode-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* HERO */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10vh; /* Hero height fixed at 15vh */
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .hero-text p {
    font-size: 1.2rem;
  }

  /* HAMBURGER MENU */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
  }

  .hamburger-menu span {
    width: 30px;
    height: 3px;
    background: white;
    transition: 0.3s;
  }

  /* MOBILE NAV */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
      position: absolute;
      right: 20px;
    }

    .nav-right {
      display: none; /* Hide nav in mobile */
    }

    .navbar-links {
      position: absolute;
      top: 50px;
      right: 0;
      width: 100%;
      flex-direction: column;
      align-items: center;
      display: none;
      padding: 15px 0;
      background: var(--hero-gradient); /* Inherit hero gradient */
      backdrop-filter: blur(10px);
    }

    .navbar-links.show {
      display: flex;
    }

    .nav-link {
      color: white;
    }
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector("#navbar-links");

  if (menuToggle && navbarLinks) {
    menuToggle.addEventListener("click", () => {
      navbarLinks.classList.toggle("show");
    });
  }
</script>
