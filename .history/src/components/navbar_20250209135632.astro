---
const { title, description } = Astro.props;
---

<nav class="navbar">
  <div class="container">
    <!-- Mode Toggle Button (Moved to Top Left) -->
    <button id="mode-toggle" class="mode-toggle">🌙</button>

    <!-- Left Side: Name & Profile -->
    <div class="hero-left">
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Right Side: Navigation Links -->
    <div class="nav-right">
      <ul class="navbar-links" id="navbar-links">
        <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
        <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
        <li>
          <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
        </li>
        <li class="nav-item">
          <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download
            >My CV</a
          >
        </li>
      </ul>
    </div>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  /* NAVBAR */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background: transparent;
    color: white;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Mode Toggle Button - Top Left */
  .mode-toggle {
    position: absolute;
    top: 15px;
    left: 15px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* Left Side: Profile */
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: absolute;
    left: 5%;
    top: 50%;
    transform: translateY(-50%);
  }

  .profile-photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 4px;
    margin-top: 250px;
  }

  .profile-photo img {
    width: 175px;
    height: 175px;
    border-radius: 50%;
  }

  /* Right Side: Nav Links */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    position: absolute;
    right: 5%;
    top: 15px;
  }

  .navbar-links {
    display: flex;
    list-style: none;
    gap: 20px;
  }

  .nav-link {
    text-decoration: none;
    color: white;
    font-size: 1rem;
  }

  /* HERO */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10vh;
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .hero-text p {
    font-size: 1.2rem;
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector("#navbar-links");

  if (menuToggle && navbarLinks) {
    menuToggle.addEventListener("click", () => {
      navbarLinks.classList.toggle("show");
    });
  }

  // Day/Night Mode Toggle
  const modeToggle = document.getElementById("mode-toggle");

  if (modeToggle) {
    modeToggle.addEventListener("click", () => {
      document.body.classList.toggle("dark-mode");
      const icon = document.body.classList.contains("dark-mode") ? "🌞" : "🌙";
      modeToggle.textContent = icon;
    });
  }
</script>
