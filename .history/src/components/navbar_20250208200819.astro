---
const { title, description } = Astro.props;
---

<nav class="navbar">
  <div class="container">
    <!-- Left-Aligned Profile & Name -->
    <div class="navbar-brand-container">
      <a class="navbar-brand" href="/">Brian Cash</a>
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Navigation Links & Mode Toggle (Right-Aligned) -->
    <div class="nav-right">
      <ul class="navbar-links" id="navbar-links">
        <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
        <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
        <li>
          <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
        </li>
        <li class="nav-item">
          <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download
            >My CV</a
          >
        </li>
      </ul>
      <button id="mode-toggle" class="mode-toggle">🌙</button>
    </div>

    <!-- Hamburger Menu Button -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  /* NAVBAR STYLES */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 20px;
    background: transparent;
    color: white;
    position: absolute;
    top: 10px; /* Moved higher */
    left: 0;
    width: 100%;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* LEFT SECTION: Profile & Name */
  .navbar-brand-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    margin-left: 20px;
  }

  .navbar-brand {
    font-size: 1.8rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 4px;
  }

  .profile-photo img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
  }

  /* RIGHT SECTION: Nav Links & Mode Toggle */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .navbar-links {
    display: flex;
    list-style: none;
    gap: 20px;
    align-items: center;
    margin-top: -15px; /* Moved higher */
  }

  .nav-link {
    text-decoration: none;
    color: white;
    font-size: 1rem;
  }

  .mode-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* HAMBURGER MENU */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
  }

  .hamburger-menu span {
    width: 30px;
    height: 3px;
    background: white;
    transition: 0.3s;
  }

  /* HERO CONTENT ADJUSTMENTS */
  .hero-content {
    margin-top: 200px; /* Pushed title & description lower */
    text-align: center;
  }

  .hero-content h1 {
    font-size: 2.5rem;
  }

  .hero-content p {
    font-size: 1.2rem;
    margin-top: 10px;
  }

  /* MOBILE STYLES */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
    }

    .nav-right {
      display: none; /* Hide links in mobile view */
    }

    .navbar-links {
      position: absolute;
      top: 60px;
      right: 0;
      width: 100%;
      flex-direction: column;
      align-items: center;
      display: none;
      padding: 15px 0;
      background: var(--hero-gradient); /* Inherit hero gradient */
      backdrop-filter: blur(10px); /* Subtle blur for better readability */
    }

    .navbar-links.show {
      display: flex;
    }

    .nav-link {
      padding: 10px;
      font-size: 1.2rem;
    }

    .hero-content {
      margin-top: 220px; /* More spacing for mobile */
    }
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector("#navbar-links");

  if (menuToggle && navbarLinks) {
    menuToggle.addEventListener("click", () => {
      navbarLinks.classList.toggle("show");
    });
  }
</script>
