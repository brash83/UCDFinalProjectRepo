---
const { title, description } = Astro.props;
---

<nav class="navbar">
  <div class="container">
    <!-- Left Side: Name & Profile -->
    <div class="hero-left">
      <div class="profile-photo">
        <img src="/UCDFinalProjectRepo/images/me.jpg" alt="Profile Photo" />
      </div>
    </div>

    <!-- Right Side: Navigation Links -->
    <div class="nav-right">
      <ul class="navbar-links" id="navbar-links">
        <li><a href="/UCDFinalProjectRepo/" class="nav-link">Home</a></li>
        <li><a href="/UCDFinalProjectRepo/about" class="nav-link">About</a></li>
        <li>
          <a href="/UCDFinalProjectRepo/projects" class="nav-link">Projects</a>
        </li>
        <li>
          <a href="/UCDFinalProjectRepo/contact" class="nav-link">Contact</a>
        </li>
        <li class="nav-item">
          <a href="/UCDFinalProjectRepo/CV.pdf" class="nav-link" download
            >My CV</a
          >
        </li>
      </ul>
      <button id="mode-toggle" class="mode-toggle">🌙</button>
    </div>

    <!-- Hamburger Menu (Mobile) -->
    <button id="menu-toggle" class="hamburger-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </div>
</section>

<style>
  /* NAVBAR */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    background: transparent;
    color: white;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  /* Left Side: Profile */
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: absolute;
    left: 5%;
    top: 50%;
    transform: translateY(-50%);
  }

  .profile-photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    padding: 4px;
    margin-top: 250px; /* Added margin to move profile photo down */
  }

  .profile-photo img {
    width: 175px;
    height: 175px;
    border-radius: 50%;
  }

  /* Right Side: Nav Links */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    position: absolute;
    right: 5%;
    top: 15px; /* Adjusted top position */
  }

  .navbar-links {
    display: flex;
    list-style: none;
    gap: 20px;
  }

  .nav-link {
    text-decoration: none;
    color: white;
    font-size: 1rem;
  }

  .mode-toggle {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  /* HERO */
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 10vh;
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
  }

  .hero-text h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .hero-text p {
    font-size: 1.2rem;
  }

  /* Navbar styling for hamburger menu */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    color: white;
    position: relative;
    z-index: 1000;
    background-color: transparent; /* Set background to transparent or gradient */
    height: 80px;
  }

  /* When the hamburger is clicked and links are shown */
  .navbar-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-direction: column; /* Stack vertically on small screens */
    background: linear-gradient(
      to bottom,
      #103b72,
      #377bf6
    ); /* Inherited gradient for the background */
    position: absolute; /* Position it below the navbar */
    top: 80px; /* Adjust to place below navbar */
    right: 0;
    width: 100%;
    padding: 1rem 0;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Optional: Add shadow for depth */
    display: none; /* Hide by default */
    text-align: center;
  }

  /* Navbar links within the hamburger menu */
  .navbar-links .nav-link {
    font-size: 1.25rem;
    font-weight: 500;
    color: white; /* White text for the links */
    padding: 0.5rem 1rem;
    transition: background-color 0.3s;
    display: block; /* Make links block level to fill the width */
  }

  /* When hovering over the links */
  .navbar-links .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.2); /* Light hover effect */
  }

  /* Toggler (hamburger icon) for mobile */
  .navbar-toggler {
    display: none; /* Hide the default toggle button */
  }

  /* Mobile media query: Adjust when screen is small */
  @media (max-width: 768px) {
    .navbar-toggler {
      display: block; /* Show the hamburger icon on mobile */
      cursor: pointer;
      background: transparent;
      border: none;
      font-size: 2rem;
      color: white;
    }

    /* Show navbar links when hamburger is clicked */
    .navbar-toggler:checked + .navbar-collapse .navbar-links {
      display: flex;
    }

    /* Hide the navbar links on mobile by default */
    .navbar-links {
      display: none;
    }
  }
</style>

<script>
  // Hamburger Menu Toggle
  const menuToggle = document.getElementById("menu-toggle");
  const navbarLinks = document.querySelector("#navbar-links");

  if (menuToggle && navbarLinks) {
    menuToggle.addEventListener("click", () => {
      navbarLinks.classList.toggle("show");
    });
  }
</script>
